  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "code-standards check --trust-repository-code",
    "lint:fix": "code-standards check --trust-repository-code --fix",
    "typecheck": "tsrs --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "new": "node scripts/new-mockup.mts",
    "new:reel": "node scripts/new-reel.mjs",
    "shots": "node scripts/screenshots.mjs",
    "reel": "node scripts/render-reel.mjs",
    "thumbs": "node scripts/thumbnails.mjs",
    "thumbs:check": "node scripts/thumbnails.mjs --check",
    "registry": "node scripts/build-registry.mjs && shadcn build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:smoke": "node scripts/smoke-worker.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "postinstall": "patch-package --error-on-fail",
    "test:security": "node --test --test-timeout=10000 scripts/braces-depth-guard.test.mjs scripts/deepmerge-prototype-guard.test.mts .github/scripts/verify-worker-security.test.mjs .github/scripts/verify-preview-access.test.mjs",
    "test:rules": "node --test eslint-rules/rules.test.mts"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.7"
    },
    "sharp": "0.35.5",
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "undici": "^8.12.3"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "npm@12.2.1"
