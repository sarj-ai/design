{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design-lab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // nodejs_compat: /api/mcp runs `runtime = "nodejs"` and pulls in the MCP SDK.
  "compatibility_flags": ["nodejs_compat"],

  // Exclusive to one Worker: whoever holds it must release it first.
  "routes": [{ "pattern": "design.sarj.ai", "custom_domain": true }],

  "workers_dev": false,
  // A separate switch, off by default; preview.yml needs it.
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // next/image is used on the index and in the two shells. Without this
  // binding the optimiser has nothing to call and every image 500s.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
