---
import Breadcrumbs from '@sarj/docs-ui/Breadcrumbs.astro';
import CodeComparison from '@sarj/docs-ui/CodeComparison.astro';
import ReferencePage from '@sarj/docs-ui/ReferencePage.astro';
import RulePager from '@sarj/docs-ui/RulePager.astro';
import { componentCatalog, themeTokenCatalog } from '@sarj/docs-ui/catalog';
import { SIDEBAR } from '../../lib/navigation';

const exportsByComponent = Object.entries(componentCatalog);
---

<ReferencePage
  title="Components"
  description="Live components and design tokens from @sarj/docs-ui."
  sidebar={SIDEBAR}
>
  <article class="component-reference">
    <header class="bench-header">
      <p class="eyebrow">@sarj/docs-ui</p>
      <h1>Components</h1>
      <p>Live exports and design tokens from the shared Sarj documentation UI package.</p>
      <dl class="surface-counts">
        <div><dt>Components</dt><dd>{exportsByComponent.length}</dd></div>
        <div><dt>Tokens</dt><dd>{themeTokenCatalog.length}</dd></div>
      </dl>
    </header>

    <section aria-labelledby="tokens-heading">
      <div class="section-heading"><p class="eyebrow">Color contract</p><h2 id="tokens-heading">Tokens</h2></div>
      <div class="token-grid">
        {themeTokenCatalog.map((token) => (
          <article class="token-card">
            <div class="token-swatches" role="img" aria-label={`${token.cssName} in light and dark themes`}>
              <span aria-hidden="true" style={`background:${token.light}`}></span>
              <span aria-hidden="true" style={`background:${token.dark}`}></span>
            </div>
            <code>{token.cssName}</code>
            <p>{token.purpose}</p>
            <small>{token.light} · {token.dark}</small>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="components-heading">
      <div class="section-heading"><p class="eyebrow">Published surface</p><h2 id="components-heading">Components</h2></div>
      <div class="component-list">
        {exportsByComponent.map(([name, definition]) => (
          <article class="component-card" id={name.toLowerCase()}>
            <header><h3>{name}</h3><code>{definition.exportPath}</code></header>
            <p>{definition.purpose}</p>
            {name === 'Breadcrumbs' && (
              <div class="specimen" aria-label="Breadcrumbs specimen">
                <Breadcrumbs
                  ancestors={[{ label: 'Components', href: '#components-heading' }, { label: 'Navigation', href: '#breadcrumbs' }]}
                  current="Breadcrumbs"
                />
              </div>
            )}
            {name === 'CodeComparison' && (
              <div class="specimen" aria-label="Code comparison specimen">
                <CodeComparison
                  id="documentation-ui-example"
                  before={{
                    label: 'Before — flagged',
                    files: [{ source: 'const enabled = false;', language: 'ts', marks: { range: '1' } }],
                  }}
                  after={{
                    label: 'After — passes',
                    files: [{ source: 'const enabled = true;', language: 'ts', marks: { range: '1' } }],
                  }}
                />
              </div>
            )}
            {name === 'PageAnchor' && (
              <div class="specimen"><a href="#_top">Focus the live PageAnchor at the top of this page</a></div>
            )}
            {name === 'ReferencePage' && (
              <div class="specimen shell-specimen">
                <span>Header</span><strong>ReferencePage</strong><span>Document surface</span>
              </div>
            )}
            {name === 'RulePager' && (
              <div class="specimen"><RulePager previous={{ href: '#referencepage', label: 'ReferencePage' }} next={{ href: '#tokens-heading', label: 'Tokens' }} /></div>
            )}
            <dl class="property-list">
              {Object.entries(definition.properties).map(([property, purpose]) => (
                <div><dt><code>{property}</code></dt><dd>{purpose}</dd></div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>
  </article>
</ReferencePage>
